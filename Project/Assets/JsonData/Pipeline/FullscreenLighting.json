{
  "Name": "FullscreenLighting",

  "PipelineKind": "MeshGraphics",

  "Shaders": {
    "MS": "Fullscreen/FullscreenCopy.MS.hlsl",
    "PS": "Fullscreen/FullscreenLighting.PS.hlsl"
  },

  "Rasterizer": {
    "CullMode": "None",
    "FillMode": "Solid"
  },

  "Blend": {
