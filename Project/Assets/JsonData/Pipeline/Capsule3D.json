{
  "Name": "Capsule3D",

  "PipelineKind": "MeshGraphics",

  "Shaders": {
    "MS": "Graphics3D/Capsule3D.MS.hlsl",
    "PS": "Graphics3D/Primitive3D.PS.hlsl"
  },

  "Rasterizer": {
    "CullMode": "Back",
    "FillMode": "Solid"
  },

  "Blend": {
    "Mode": "None"
  },

  "Depth": {
    "Enable": true,
    "Write": true,
    "Func": "LessEqual"
  },

  "RenderTarget": {
    "Formats": [
      "R8G8B8A8_UNORM_SRGB",
      "R16G16B16A16_FLOAT"
    ]
  },

  "DepthStencil": {
    "Format": "D24_UNORM_S8_UINT"
  },

  "PrimitiveTopology": "Triangle"
}
